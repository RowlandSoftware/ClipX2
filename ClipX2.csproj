<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Version>2.0.0</Version>
	<LangVersion>latest</LangVersion>
    <!-- Applied by ApplicationConfiguration.Initialize() in Program.cs -->
    <!-- Default font for all forms and controls that don't set their own. The forms use AutoScaleMode.Font,
         so the layout scales to suit it. -->
    <ApplicationDefaultFont>Segoe UI, 10pt</ApplicationDefaultFont>
    <!-- Same DPI behaviour as under .NET Framework for now; PerMonitorV2 gives sharp text on high-DPI screens -->
    <ApplicationHighDpiMode>DpiUnaware</ApplicationHighDpiMode>
  </PropertyGroup>
<PropertyGroup>
  <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
</PropertyGroup>
<ItemGroup>
  <!-- The text engine is its own class library (TextEngine\ClipX2.TextEngine.csproj); do not compile its files here too -->
  <Compile Remove="TextEngine\**" />
  <EmbeddedResource Remove="TextEngine\**" />
  <None Remove="TextEngine\**" />
</ItemGroup>
<ItemGroup>
  <ProjectReference Include="TextEngine\ClipX2.TextEngine.csproj" />
</ItemGroup>
<ItemGroup>
  <PackageReference Include="Svg" Version="3.4.8" />
  <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="11.0.0" />
</ItemGroup>
<ItemGroup>
  <Compile Update="Properties\Resources.Designer.cs">
    <DesignTime>True</DesignTime>
    <AutoGen>True</AutoGen>
    <DependentUpon>Resources.resx</DependentUpon>
  </Compile>
  <!-- Form1's code-only parts: open as code (the designer would add a .resx clashing with Form1.resx) -->
  <Compile Update="UI\Form1.Conversion.cs"><SubType>Code</SubType></Compile>
  <Compile Update="UI\Form1.Styles.cs"><SubType>Code</SubType></Compile>
  <Compile Update="UI\Form1.Tools.cs"><SubType>Code</SubType></Compile>
  <Compile Update="UI\Form1.Find.cs"><SubType>Code</SubType></Compile>
  <Compile Update="UI\Form1.PowerButtons.cs"><SubType>Code</SubType></Compile>
  <Compile Update="UI\PowerButtonBar.cs"><SubType>Code</SubType></Compile>
</ItemGroup>
<ItemGroup>
  <EmbeddedResource Update="Properties\Resources.resx">
    <Generator>ResXFileCodeGenerator</Generator>
    <LastGenOutput>Resources.Designer.cs</LastGenOutput>
  </EmbeddedResource>
</ItemGroup>
<ItemGroup>
  <!-- Hunspell dictionaries (.aff/.dic) and the seed personal dictionary -->
  <None Update="Dictionaries\*.*">
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
  </None>
  <None Update="icons\Capitals.svg">
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
  </None>
  <None Update="icons\CapSentences.svg">
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
  </None>
  <None Update="icons\InitialCaps.svg">
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
  </None>
  <None Update="icons\lower.svg">
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
  </None>
  <None Update="icons\rEveRse.svg">
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
  </None>
  <None Update="icons\Sentence.svg">
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
  </None>
  <None Update="icons\Title.svg">
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
  </None>
</ItemGroup>
</Project>
